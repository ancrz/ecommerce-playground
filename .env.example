# =======================================================
# === MINIMALIST E-COMMERCE - Backend Environment ===
# =======================================================
# Este archivo configura el BACKEND (Python/FastAPI).
# Copiar como .env antes de ejecutar cualquier script.

# ===== Base de Datos (Seleccionar Motor) =====
# Opciones: sqlite | postgres
DB_TYPE=sqlite

# Configuración SQLite (Usar si DB_TYPE=sqlite)
DB_PATH=./data/database

# Configuración PostgreSQL (Usar si DB_TYPE=postgres)
# Asegúrate de que el servicio PostgreSQL esté corriendo localmente.
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASS=admin2024
DB_NAME=ecommerce_unified

# ===== Uploads =====
UPLOAD_PATH=./data/uploads

# ===== Servidor Backend (FastAPI) =====
BACKEND_HOST=localhost
BACKEND_PORT=8042
BACKEND_URL=http://localhost:8042

# ===== Servidor Frontend (Vite) =====
FRONTEND_HOST=localhost
FRONTEND_PORT=5173

# ===== Credenciales Admin Default =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin2024

# ===== JWT Security =====
# Generar nuevo con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=T4h2yj-bq-YXBIHinixY7YHC-3DG714DqiR-IQxVNNQ
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===== Servicios Externos (Opcional - Desarrollo) =====
# SMTP para recuperación de contraseña
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=changeme
SMTP_FROM_EMAIL=no-reply@example.com

# hCaptcha (dejar vacío para dev, el backend omite validación)
HCAPTCHA_SECRET_KEY=

# ===== Feature Flags =====
DEBUG=true
ENABLE_DOCS=true

# ===== Logging =====
# Opciones: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=ERROR

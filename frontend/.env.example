# =======================================================
# === FRONTEND ENVIRONMENT EXAMPLE - Vite/React ===
# =======================================================
# Copiar este archivo como .env en el directorio frontend/
#
# Variables con prefijo VITE_ se exponen al cliente
# Acceso: import.meta.env.VITE_NOMBRE_VARIABLE
#
# IMPORTANTE: Este archivo NO debe contener secretos
# ya que las variables se incluyen en el bundle final.

# URL base del API (para desarrollo local, Vite usa proxy)
VITE_API_URL=/api

# URL base del backend (para imágenes y assets)
VITE_BACKEND_URL=http://localhost:8042

# Nombre de la aplicación (para SEO y títulos)
VITE_APP_NAME=E-Commerce Demo

# Modo de desarrollo (true/false)
VITE_DEBUG=true
